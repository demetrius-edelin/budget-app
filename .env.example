# Copy this file to .env and change the values.
DATA_DIR=~/spendtrack-data
WEB_HOST=127.0.0.1
WEB_PORT=8000
TIMEZONE=Europe/Bucharest
# Set these three only if you want access from another machine.
# ALLOW_REMOTE=true
# BASIC_AUTH_USER=demi
# BASIC_AUTH_PASSWORD=change-me

# Telegram entry from the phone (optional). Leave the token empty to run without the bot.
# 1. Create a bot with @BotFather and paste its token here.
# 2. Start the app, send the bot a message, and read your user id in the log.
# 3. Put that id here and restart.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
# The bot parses messages with a model. Pick the provider and set its key.
# anthropic (default): ANTHROPIC_API_KEY, AI_MODEL optional (default claude-opus-5-5)
# openai: OPENAI_API_KEY and AI_MODEL (an OpenAI model id)
# openrouter: OPENROUTER_API_KEY and AI_MODEL (an OpenRouter id such as anthropic/claude-opus-5-5)
AI_PROVIDER=anthropic
AI_MODEL=
# Reasoning effort: none, minimal, low, medium, high, xhigh, max, or off (provider default).
AI_EFFORT=low
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
